<UserControl x:Class="FH6LocalCryptoTool.Help.TabHelpButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="22" Height="22" Margin="8,0,0,0" VerticalAlignment="Center"
             Focusable="False" UseLayoutRounding="True">
  <Button x:Name="HelpButton" Content="?" Click="Help_Click" Cursor="Hand"
          ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="8000">
    <Button.Style>
      <Style TargetType="Button">
        <Setter Property="Foreground" Value="#FFE8175D"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#AAE8175D"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1" CornerRadius="11">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="#FFFF4A84"/>
                  <Setter Property="Background" Value="#20E8175D"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter Property="BorderBrush" Value="#FFFF4A84"/>
                  <Setter Property="Background" Value="#20E8175D"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="Background" Value="#38E8175D"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Button.Style>
  </Button>
</UserControl>
